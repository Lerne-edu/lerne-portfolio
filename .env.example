# portfolio@lerne: environment values.
# Copy this file to .env.local (same folder) and fill it in. Never commit .env.local or share it.
# SETUP-GUIDE.md explains where to find every value. Run "npm run check" to test them.

# ---------- REQUIRED ----------
# Supabase > Project Settings > API (or API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key        # PRIVATE: server only, never share

# The address of this site: http://localhost:3000 on your computer, https://portfolio.lerne.co.in once live
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any long random text; protects the daily job. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=a-long-random-string

# ---------- SECURITY SWITCHES (leave false until tested; see SECURITY.md) ----------
CSP_ENFORCE=false
REQUIRE_ADMIN_MFA=false

# ---------- PARENT SIGN-IN ----------
# Parents sign in with a code sent to their EMAIL (free). Turn on the mobile SMS option only after
# DLT registration and an SMS provider are ready (see SETUP-GUIDE.md).
PARENT_SMS_LOGIN=false

# ---------- EMAIL to parents (optional): resend.com ----------
RESEND_API_KEY=
NOTIFY_FROM=Lerne <noreply@lerne.co.in>

# ---------- PAYMENTS (optional): razorpay.com ----------
INDIVIDUAL_PLAN_PRICE_INR=
MENTOR_SESSION_PRICE_INR=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- SMS notifications and invites (optional): msg91.com ----------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_INVITE_TEMPLATE_ID=
MSG91_VAR_NAME=VAR1

# ---------- WHATSAPP (optional): Meta WhatsApp Cloud API ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_INVITE_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---------- AI SUMMARY DRAFTS (optional): console.anthropic.com ----------
ANTHROPIC_API_KEY=
